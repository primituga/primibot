# --- Discord Credentials ---
DISCORD_TOKEN=your_discord_bot_token_here

# --- Twitch Credentials ---
TWITCH_BOT_ID=your_twitch_bot_id
TWITCH_TOKEN=oauth:your_twitch_oauth_token_here
TWITCH_CHANNEL=channel1,channel2,channel3
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# --- AI Credentials ---
# Local stack (preferred path)
FLOW_ID=your_primary_flowise_chatflow_id
FLOW_ID_PI=your_secondary_flowise_chatflow_id
FLOWISE_USERNAME=change_me
FLOWISE_PASSWORD=change_me

# Cloud fallbacks (optional)
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENCODE_ZEN_API_KEY=your_zen_api_key_here

# --- Internal Configuration ---
SEARXNG_URL=http://searxng:8080/search
SEARXNG_SECRET=generate_a_long_random_string
REDIS_URL=redis://redis:6379/0
WEBHOOK_URL=

# --- Discord IDs ---
GUILD_ID=0
LOG_CHANNEL_ID=0
LOG_CHANNEL_ID_TWITCH=0
